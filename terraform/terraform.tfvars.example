# Copy this file to terraform.tfvars and adjust values for your AWS account.
# Do not commit terraform.tfvars or AWS credentials.

aws_region          = "ap-south-1"
project_name        = "appoint"
environment         = "demo"
kubernetes_version  = "1.34"
node_instance_types = ["t3.micro"]
node_min_size       = 1
node_desired_size   = 1
node_max_size       = 2
